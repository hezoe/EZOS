[Unit]
Description=EZOS - Claude web UI
# docker0(172.17.0.1)は dockerd 起動後に現れるため、その後に起動させる。
# Docker未導入の機でも起動できるよう依存はWants(弱依存)で表現し、順序のみAfterで固定。
# なお万一先に起動しても server.js が EADDRNOTAVAIL をリトライ吸収する(二重の保険)。
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=debian
WorkingDirectory=/home/debian/EZOS/app
# --max-old-space-size: V8ヒープの上限(MB)。この機は総メモリ約1GBと逼迫しがちなので、
# 万一のリーク/暴走で node が青天井にヒープを伸ばし機ごと OOM に巻き込むのを防ぐ保険
# (平常時のサーバーは30MB前後なので128MBは十分な余裕)。このフラグは node 自身にのみ効き、
# claude.js が spawn する claude(これも node製)には波及しない。NODE_OPTIONS 環境変数だと
# 子まで継承され Claude Code のヒープまで縛ってしまうため、あえて ExecStart 引数で渡す。
ExecStart=/usr/bin/node --max-old-space-size=128 server.js
Restart=always
RestartSec=3
# nodeプロセスのみ停止し、node-ptyが起動したtmuxサーバー(=永続ターミナル)は
# 再起動/デプロイをまたいで生かし続ける
KillMode=process
Environment=NODE_ENV=production
Environment=HOME=/home/debian

[Install]
WantedBy=multi-user.target

# /etc/secguard.conf(root 0600)。実値(自宅などの IP)は repo に入れない。
# ACTION=enforce は遮断・停止する。observe は知らせるだけ。
ACTION=enforce
# 遮断しない IP/CIDR(空白区切り)。VPN(10.x)・内部・VPS 自身は最初から対象外
ALLOW_IPS=
# 期限なしに遮断する IPv4 区画(空白区切り。常習の発信元。/16 より狭いもの)。書き換えたら systemctl restart secguard
BLOCK_NETS=
BAN_SEC=86400
WEB_BAN_SCORE=10
WEB_404_BAN=80
WEB_FLOOD_REQ=3000
# この時刻(epoch)までは、公開サービスの見覚えのない実行・待ち受けを覚えるだけ(止めない)。install.sh が 48 時間後を入れる
LEARN_UNTIL=0
# コンテナの起動からこの秒数の実行は起動の手順として記録だけ(止めない)
CONTAINER_START_GRACE=120
DIGEST_SEC=1800
NOTIFY_MAX_PER_HOUR=30

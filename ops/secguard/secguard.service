[Unit]
Description=secguard: 外部に面した部分の見張り(Web の攻撃→IP 遮断・乗っ取りの兆候→そのサービスだけ停止・ntfy)
Documentation=file:/home/debian/EZOS/ops/secguard/README.md
After=network-online.target docker.service auditd.service catvpn-hub-firewall.service
Wants=auditd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/sbin/secguard.py
Restart=always
RestartSec=10
# root で動く(ipset・systemctl stop・docker stop のため)。外からの文字列を読むので書ける場所を絞る
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/secguard
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=300M

[Install]
WantedBy=multi-user.target

#!/bin/bash
# secguard が隔離した(止めた)サービスを戻す。確かめてから使う。
#   sudo secguard-release            隔離中の一覧
#   sudo secguard-release <名前>     印を消して起動し直す(ogn/navlog/notam/takikawa/flightlog/postgres)
set -eu
Q=/var/lib/secguard/quarantine
[ "$(id -u)" -eq 0 ] || { echo "sudo で実行してください" >&2; exit 1; }
if [ $# -eq 0 ]; then
  ls -1 "$Q" 2>/dev/null | while read -r n; do printf '%-12s %s\n' "$n" "$(head -c 200 "$Q/$n" | tr '\n' ' ')"; done
  exit 0
fi
g="$1"
case "$g" in
  ogn) units="ogn-web ogn-collect"; timers="ogn-web-drone ogn-web-dropzones ogn-web-amedas ogn-web-wind ogn-notify-receivers"; wd="ogn-web ogn-collect" ;;
  navlog) units="navlog"; timers=""; wd="navlog" ;;
  notam) units="notam"; timers=""; wd="notam" ;;
  takikawa) units="takikawa-web"; timers=""; wd="takikawa" ;;
  flightlog) units=""; timers=""; wd="flightlog"; ctrs="flightlog-app" ;;
  postgres) units=""; timers=""; wd="flightlog"; ctrs="saas-postgres flightlog-app" ;;
  *) echo "知らない名前: $g" >&2; exit 2 ;;
esac
rm -f "$Q/$g"; for n in $wd; do rm -f "$Q/$n"; done
for u in $units; do systemctl start "$u.service"; done
for t in $timers; do systemctl start "$t.timer"; done
for c in ${ctrs:-}; do docker update --restart=unless-stopped "$c" >/dev/null; docker start "$c" >/dev/null; done
systemctl restart secguard.service   # 隔離の記憶(同じ名前は二度止めない)を消す
echo "戻しました: $g"

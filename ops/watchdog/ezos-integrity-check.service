[Unit]
Description=EZOS integrity check: signed HEAD, working tree matches, npm audit (notify on findings)
Documentation=file:/home/debian/EZOS/ops/watchdog/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=debian
ExecStart=/usr/local/bin/ezos-integrity-check.sh /etc/service-watchdog.conf
TimeoutStartSec=300
